DJANGO_SECRET_KEY=replace-with-long-random-value
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
POSTGRES_DB=meatflow
POSTGRES_USER=meatflow
POSTGRES_PASSWORD=change-this
POSTGRES_HOST=db
POSTGRES_PORT=5432
DJANGO_TRUST_PROXY=0
DJANGO_SSL_REDIRECT=0

# Set this to an existing external drive or synced directory for scheduled Docker backups.
BACKUP_HOST_DIR=./backups
# For HTTPS compose override, provide fullchain.pem and privkey.pem in this directory.
TLS_CERT_DIR=./certs
DJANGO_HSTS_SECONDS=0
DJANGO_HSTS_INCLUDE_SUBDOMAINS=0
DJANGO_HSTS_PRELOAD=0
